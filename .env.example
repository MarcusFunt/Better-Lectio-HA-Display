# Copy this file to .env and fill in only the settings you use.
TIMEZONE=Europe/Copenhagen
# Home Assistant display and Lectio API credentials are configured on the
# Lectio sign-in page at http://localhost:8000/auth/browser.
# For a Home Assistant host on another machine, bind the API to a reserved
# server LAN address and restrict its port with the host firewall.
LECTIO_HA_API_BIND_ADDRESS=127.0.0.1
LECTIO_HA_API_HOST_PORT=8002
DISPLAY_BIND_ADDRESS=127.0.0.1
DISPLAY_HOST_PORT=8001
LECTIO_AUTH_BROWSER_VIEW_URL=http://localhost:6080/vnc.html?autoconnect=true&resize=scale
LECTIO_AUTH_TIMEOUT_SECONDS=900

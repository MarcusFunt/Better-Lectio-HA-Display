# Copy this file to .env and fill in only the settings you use.
TIMEZONE=Europe/Copenhagen
HOME_ASSISTANT_URL=http://homeassistant.local:8123
HOME_ASSISTANT_TOKEN=
HA_LECTIO_CALENDAR=calendar.lectio
HA_PRIVATE_CALENDARS=calendar.private
HA_ASSIGNMENTS_TODO=todo.lectio_assignments
HA_HOMEWORK_TODO=todo.lectio_homework
HA_CANCELLATIONS_SENSOR=sensor.lectio_cancellations
DISPLAY_BIND_ADDRESS=127.0.0.1
DISPLAY_HOST_PORT=8001
LECTIO_AUTH_BROWSER_VIEW_URL=http://localhost:6080/vnc.html?autoconnect=true&resize=scale
LECTIO_AUTH_TIMEOUT_SECONDS=900

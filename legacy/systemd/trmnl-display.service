[Unit]
Description=TRMNL Lectio and calendar display server
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=trmnl
Group=trmnl
WorkingDirectory=/opt/trmnl-display
EnvironmentFile=-/etc/trmnl-display.env
ExecStart=/opt/trmnl-display/.venv/bin/waitress-serve --listen=0.0.0.0:5000 --threads=1 trmnl_schedule.wsgi:app
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/trmnl-display

[Install]
WantedBy=multi-user.target

[Unit]
Description=Refresh TRMNL Lectio and calendar image
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=trmnl
Group=trmnl
WorkingDirectory=/opt/trmnl-display
EnvironmentFile=-/etc/trmnl-display.env
ExecStart=/opt/trmnl-display/.venv/bin/python -m trmnl_schedule.refresh
TimeoutStartSec=180s
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/trmnl-display
